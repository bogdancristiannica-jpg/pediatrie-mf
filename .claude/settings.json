{
  "permissions": {
    "allow": [
      "Bash(npm run validate*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run test*)",
      "Bash(npm run check*)",
      "Bash(npm test*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright install*)",
      "Bash(node scripts/*)",
      "Bash(node --test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(xcrun simctl list*)",
      "Bash(xcrun simctl boot*)",
      "Bash(xcrun simctl openurl*)",
      "Bash(xcrun simctl io *)",
      "Bash(open -a Simulator*)"
    ],
    "deny": ["Read(.env)", "Read(.env.*)"]
  }
}
