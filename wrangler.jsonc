// Configurație Cloudflare Workers (varianta „Workers cu fișiere statice”).
// Folosită când depozitul e conectat prin Workers Builds („Import a repository” în panoul Cloudflare)
// sau la publicarea manuală de pe Mac: `npm run deploy`.
// Numele de aici trebuie să fie identic cu numele Worker-ului din panou, altfel build-ul eșuează.
// Varianta Pages (Create application → Pages → Connect to Git) nu folosește acest fișier.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pediatrie-mf",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": false },
}
