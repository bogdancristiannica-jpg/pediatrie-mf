{
  "name": "pediatrie-mf",
  "version": "0.1.2",
  "description": "Fișe clinice pediatrice 0–6 ani pentru medicul de familie, după ghidurile europene în vigoare",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-data.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run build && npm run serve",
    "deploy": "npm run build && wrangler deploy",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium --project=iphone-chromium",
    "test": "npm run validate && npm run test:unit",
    "check": "npm run validate && npm run lint && npm run build && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.147.0"
  }
}
